---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import StoryCard from "~/components/StoryCard.astro";
import { articlesInSection, sectionsWithArticles } from "~/data/articles";

export const getStaticPaths = () =>
	sectionsWithArticles.map(section => ({
		params: { slug: section.slug },
		props: { section }
	}));

const { section } = Astro.props;
const sectionArticles = articlesInSection(section.slug);
---

<BaseLayout
	title={`${section.label} — TheNewsRoo`}
	description={`Local reporting filed under ${section.label}.`}
>
	<Breadcrumbs
		crumbs={[{ href: "/", label: "Home" }, { label: section.label }]}
	/>

	<h1 class="mt-3 text-4xl font-bold">{section.label}</h1>
	<p class="text-muted font-ui mt-2 text-sm">
		{`${sectionArticles.length} ${sectionArticles.length === 1 ? "story" : "stories"}`}
	</p>

	<div
		class="mt-8 grid gap-x-8 gap-y-10 border-t border-line pt-8 sm:grid-cols-2 lg:grid-cols-3"
	>
		{sectionArticles.map(article => <StoryCard article={article} />)}
	</div>

	<nav class="section-block" aria-label="Other sections">
		<p class="kicker">Other sections</p>
		<div class="mt-3 flex flex-wrap gap-2">
			{
				sectionsWithArticles
					.filter(other => other.slug !== section.slug)
					.map(other => (
						<a class="control hover:bg-surface-2" href={`/topics/${other.slug}`}>
							{other.label}
						</a>
					))
			}
		</div>
	</nav>
</BaseLayout>
