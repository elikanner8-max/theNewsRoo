---
import BaseLayout from "~/layouts/BaseLayout.astro";
import StoryCard from "~/components/StoryCard.astro";
import {
	latestArticles,
	leadArticle,
	moreArticles,
	secondaryArticles
} from "~/data/articles";
---

<BaseLayout title="The NewsRoo">
	<div class="grid gap-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,3fr)]">
		<StoryCard article={leadArticle} variant="lead" />

		<aside
			class="rounded-[var(--radius-card)] border border-line bg-surface p-5 lg:self-start"
		>
			<h2 class="kicker">Latest</h2>
			<ul class="mt-3 flex flex-col">
				{
					latestArticles.map(article => (
						<li class="border-t border-line py-4 first:border-t-0 first:pt-0 last:pb-0">
							<StoryCard article={article} variant="list" />
						</li>
					))
				}
			</ul>
			<a
				class="font-ui mt-4 inline-block text-sm font-medium hover:text-accent hover:underline"
				href="/search"
			>
				Browse all stories →
			</a>
		</aside>
	</div>

	<section class="mt-12 border-t border-line pt-8">
		<div class="flex flex-wrap items-baseline justify-between gap-3">
			<h2 class="text-2xl font-bold">More from the newsroom</h2>
			<a
				class="font-ui text-sm hover:text-accent hover:underline"
				href="/search"
			>
				See all →
			</a>
		</div>

		<div class="mt-6 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
			{secondaryArticles.map(article => <StoryCard article={article} />)}
		</div>
	</section>

	<section class="mt-12 border-t border-line pt-8">
		<h2 class="text-2xl font-bold">Also today</h2>

		<ul class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				moreArticles.map(article => (
					<li>
						<StoryCard article={article} variant="list" />
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>
