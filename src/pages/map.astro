---
import BaseLayout from "~/layouts/BaseLayout.astro";
import MapExplorer from "~/components/islands/MapExplorer";
import { articles, sectionLabel } from "~/lib/articles";

const mapArticles = articles.map(article => ({
	slug: article.slug,
	title: article.title,
	sectionLabel: sectionLabel(article.sectionSlug),
	location: article.location,
	views: article.views,
	lat: article.lat,
	lon: article.lon
}));
---

<BaseLayout
	title="Map — TheNewsRoo"
	description="Every published story, placed where it was reported."
>
	<h1 class="text-4xl font-bold">Map</h1>
	<p class="text-ink-soft mt-2 max-w-prose">
		Every published story sits where it was reported. Pan and zoom to find
		reporting from anywhere.
	</p>

	<div class="mt-6">
		<MapExplorer client:only="react" articles={mapArticles} />
	</div>
</BaseLayout>
