---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import SearchApp from "~/components/islands/SearchApp";
import { articles, sectionLabel, sectionsWithArticles } from "~/data/articles";

const searchResults = articles.map(article => ({
	slug: article.slug,
	title: article.title,
	dek: article.dek,
	sectionSlug: article.sectionSlug,
	sectionLabel: sectionLabel(article.sectionSlug),
	byline: article.byline,
	location: article.location,
	publishedAt: article.publishedAt,
	readMinutes: article.readMinutes
}));
---

<BaseLayout
	title="Search — TheNewsRoo"
	description="Search local reporting by headline, section, reporter, or place."
>
	<Breadcrumbs crumbs={[{ href: "/", label: "Home" }, { label: "Search" }]} />

	<div class="mx-auto mt-6 max-w-[44rem]">
		<h1 class="text-4xl font-bold">Search</h1>

		<div class="mt-6">
			<SearchApp client:load articles={searchResults} />
		</div>

		<nav class="section-block" aria-label="Browse sections">
			<p class="kicker">Browse by section</p>
			<div class="mt-3 flex flex-wrap gap-2">
				{
					sectionsWithArticles.map(section => (
						<a class="control hover:bg-surface-2" href={`/topics/${section.slug}`}>
							{section.label}
						</a>
					))
				}
			</div>
		</nav>
	</div>
</BaseLayout>
