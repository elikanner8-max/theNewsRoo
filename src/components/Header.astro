---
import MobileNav from "~/components/islands/MobileNav";
import { sectionsWithArticles } from "~/data/articles";

const primaryLinks = [
	{ href: "/", label: "Home" },
	{ href: "/map", label: "Map" },
	{ href: "/search", label: "Search" }
];

const sectionLinks = sectionsWithArticles.map(section => ({
	href: `/topics/${section.slug}`,
	label: section.label
}));

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
	switch (href) {
		case "/":
			return pathname === "/";
		default:
			return pathname.startsWith(href);
	}
};
---

<header class="sticky top-0 z-30 border-b border-line bg-bg/90 backdrop-blur">
	<div class="shell flex items-center gap-4 py-3">
		<MobileNav
			client:idle
			primaryLinks={primaryLinks}
			sectionLinks={sectionLinks}
		/>

		<a class="text-brand shrink-0 font-bold tracking-tight" href="/">
			The NewsRoo
		</a>

		<nav class="ml-2 hidden items-center gap-1 md:flex" aria-label="Primary">
			{
				primaryLinks.map(link => (
					<a
						class:list={["pill", isActive(link.href) && "pill-active"]}
						href={link.href}
						aria-current={isActive(link.href) ? "page" : undefined}
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<a
			class="pill ml-auto shrink-0 border-ink bg-ink whitespace-nowrap text-bg hover:bg-ink-soft"
			href="/submit"
		>
			<span class="sm:hidden">Submit</span>
			<span class="hidden sm:inline">Submit a story</span>
		</a>
	</div>

	<nav
		class="border-t border-line md:block"
		aria-label="Sections"
	>
		<div class="shell flex gap-1 overflow-x-auto py-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
			{
				sectionLinks.map(link => (
					<a
						class:list={[
							"font-ui shrink-0 rounded-full px-3 py-1.5 text-sm whitespace-nowrap text-ink-soft hover:bg-surface-2",
							isActive(link.href) && "bg-surface-2 font-semibold text-ink"
						]}
						href={link.href}
						aria-current={isActive(link.href) ? "page" : undefined}
					>
						{link.label}
					</a>
				))
			}
		</div>
	</nav>
</header>
