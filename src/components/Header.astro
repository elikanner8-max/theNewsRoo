---
import MobileNav from "~/components/islands/MobileNav";

const navLinks = [
	{ href: "/", label: "Home" },
	{ href: "/map", label: "Map" },
	{ href: "/search", label: "Search" },
	{ href: "/submit", label: "Submit" }
];

const pathname = Astro.url.pathname;

const isActiveLink = (href: string) => {
	switch (href) {
		case "/":
			return pathname === "/";
		default:
			return pathname.startsWith(href);
	}
};

const buildDate = new Date();
const buildDateLabel = new Intl.DateTimeFormat("en-US", {
	weekday: "long",
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC"
}).format(buildDate);
const buildDateIso = buildDate.toISOString().slice(0, 10);
---

<header class="border-b-2 border-ink bg-bg">
	<div
		class="shell grid grid-cols-[auto_minmax(0,1fr)] items-center gap-4 pt-4 pb-3 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]"
	>
		<div class="flex items-center gap-3 justify-self-start">
			<MobileNav client:idle links={navLinks} />
			<time class="hidden text-[0.92rem] whitespace-nowrap md:inline" datetime={buildDateIso}>
				{buildDateLabel}
			</time>
		</div>

		<div class="text-right md:col-start-2 md:text-center">
			<a class="block text-brand leading-[0.92] font-extrabold" href="/">
				The NewsRoo
			</a>
			<p class="mt-1 text-muted italic">Democratizing Journalism</p>
		</div>

		<div class="hidden md:block"></div>

		<nav class="col-span-full mt-2 hidden justify-center md:flex" aria-label="Primary">
			<ul class="flex list-none flex-wrap justify-center gap-1">
				{
					navLinks.map(link => (
						<li>
							<a
								class:list={[
									"button-ui min-h-[3.05rem] px-5 font-bold hover:bg-ink hover:text-bg",
									isActiveLink(link.href) && "bg-ink text-bg"
								]}
								href={link.href}
								aria-current={isActiveLink(link.href) ? "page" : undefined}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
