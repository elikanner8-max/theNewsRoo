---
import Logo from "~/components/Logo.astro";
import SearchField from "~/components/SearchField.astro";
import MobileNav from "~/components/islands/MobileNav";
import TodayDate from "~/components/islands/TodayDate";
import { sectionsWithArticles } from "~/lib/articles";

const primaryLinks = [
	{ href: "/", label: "Home" },
	{ href: "/map", label: "Map" },
	{ href: "/videos", label: "Videos" },
	{ href: "/games", label: "Games"},
	{ href: "/submit", label: "Submit a story" },
	{ href: "/mylocal", label: "MyLocal" }
];

const sectionLinks = sectionsWithArticles.map(section => ({
	href: `/topics/${section.slug}`,
	label: section.label
}));

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
	switch (href) {
		case "/":
			return pathname === "/";
		default:
			return pathname.startsWith(href);
	}
};

const plainLink =
	"font-ui text-[0.65rem] font-semibold tracking-[0.14em] uppercase whitespace-nowrap text-ink-soft transition-colors hover:text-accent";

const buildDateLabel = new Intl.DateTimeFormat("en-US", {
	weekday: "long",
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC"
}).format(new Date());
---

<script>
	// TODO: make the hamburger close if it is open and the user clicks on part of the page outside of the menu
	document.addEventListener("DOMContentLoaded", () => {
		const hamburger = document.getElementById("header-hamburger");
		const menu = document.getElementById("header-menu");
		if (hamburger && menu) {
			hamburger.addEventListener("click", () => {
				menu.classList.toggle("hidden");
			});
		}
	});
</script>

<header class="sticky top-0 z-30 border-b border-line bg-bg">
	<div class="shell grid grid-cols-[auto_1fr_auto] items-center gap-4 py-1">
		<button
			id="header-hamburger"
			class="flex flex-col gap-1 md:hidden"
			aria-label="Menu"
			aria-expanded="false"
		>
			<span class="block h-0.5 w-6 bg-ink-soft"></span>
			<span class="block h-0.5 w-6 bg-ink-soft"></span>
			<span class="block h-0.5 w-6 bg-ink-soft"></span>
		</button>

		<MobileNav
			client:load
			primaryLinks={primaryLinks}
			sectionLinks={sectionLinks}
		/>


		<a>
			<SearchField
				class=""
			/>
		</a>

		<!-- <a
			class={`${plainLink} ${isActive("/map") ? "font-semibold text-ink" : ""}`}
			href="/map"
			aria-current={isActive("/map") ? "page" : undefined}
		>
			Map
		</a> -->
	</div>

	<div class="shell flex justify-center py-1 my-4">
		<Logo size="lg" />
	</div>

	<div class="shell flex items-center gap-6 py-1">
		<nav
			class="hidden flex-1 justify-between gap-x-4 overflow-x-auto md:flex [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
			aria-label="Categories"
		>
			{
				primaryLinks.map(link => (
					<a
						class:list={[
							"font-ui shrink-0 text-[0.65rem] font-semibold tracking-[0.14em] whitespace-nowrap uppercase transition-colors",
							isActive(link.href)
								? "text-kicker"
								: "text-ink-soft hover:text-kicker"
						]}
						href={link.href}
						aria-current={isActive(link.href) ? "page" : undefined}
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="w-px bg-line self-stretch" />

		<p
			class="font-ui text-muted ml-auto shrink-0 text-[0.65rem] tracking-[0.08em] whitespace-nowrap uppercase"
		>
			<TodayDate client:load fallback={buildDateLabel} />
		</p>
	</div>
</header>
