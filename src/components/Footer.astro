---
import Logo from "~/components/Logo.astro";
import { sectionsWithArticles } from "~/lib/articles";

const currentYear = new Date().getFullYear();

const columns = [
	{
		heading: "Sections",
		links: sectionsWithArticles.map(section => ({
			href: `/topics/${section.slug}`,
			label: section.label
		}))
	},
	{
		heading: "Explore",
		links: [
			{ href: "/", label: "Home" },
			{ href: "/map", label: "Map" },
			{ href: "/search", label: "Search" },
			{ href: "/submit", label: "Submit a story" }
		]
	},
	{
		heading: "About",
		links: [
			{ href: "/about", label: "About" },
			{ href: "/contact", label: "Contact" },
			{ href: "/faq", label: "FAQ" },
			{ href: "/submissions", label: "Submission rules" }
		]
	},
	{
		heading: "Policies",
		links: [
			{ href: "/corrections", label: "Corrections" },
			{ href: "/accessibility", label: "Accessibility" },
			{ href: "/privacy", label: "Privacy" },
			{ href: "/terms", label: "Terms" }
		]
	}
];
---

<footer class="mt-auto border-t border-line bg-surface-2/60">
	<div class="shell py-10">
		<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
			{
				columns.map(column => (
					<nav aria-label={column.heading}>
						<p class="kicker">{column.heading}</p>
						<ul class="mt-3 flex flex-col gap-2">
							{column.links.map(link => (
								<li>
									<a
										class="font-ui text-ink-soft text-sm hover:text-accent hover:underline"
										href={link.href}
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>

		<div
			class="mt-10 flex flex-wrap items-baseline justify-between gap-3 border-t border-line pt-6"
		>
			<Logo size="sm" />
			<p class="font-ui text-muted text-sm">
				© {currentYear} · Democratizing Journalism
			</p>
		</div>
	</div>
</footer>
